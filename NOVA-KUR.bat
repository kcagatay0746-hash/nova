@echo off
chcp 65001 >nul
setlocal EnableExtensions
title Nova v2 - Kurulum

rem ============================================================
rem  Nova v2 - Turkce, arac kullanabilen yapay zeka asistani
rem  Tek dosyalik kurulum: bu .bat icindeki projeyi diske acar.
rem  Cikarma: PowerShell -> Python -> tar (biri calisirsa yeter)
rem  Kullanim:  NOVA-KUR.bat            (varsayilan: .\nova-v2)
rem            NOVA-KUR.bat C:\Nova    (hedef klasor)
rem ============================================================

set "TARGET=%~dp0nova-v2"
if not "%~1"=="" set "TARGET=%~1"

echo ============================================================
echo   Nova v2 - Kurulum
echo ============================================================
echo   Hedef: %TARGET%
echo.

where powershell >nul 2>nul
if errorlevel 1 goto :NOPS

if not exist "%TARGET%" mkdir "%TARGET%" >nul 2>nul
set "ZIP=%TEMP%\nova-v2-%RANDOM%.zip"

echo [1/3] Dosyalar cikariliyor...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $self=Get-Content -LiteralPath '%~f0' -Raw -Encoding UTF8; $mb='NOVA'+'_PAYLOAD_BEGIN'; $me='NOVA'+'_PAYLOAD_END'; $i=$self.IndexOf($mb); $j=$self.IndexOf($me,$i); if($i -lt 0 -or $j -le $i){Write-Error 'Payload bulunamadi'; exit 1}; $part=$self.Substring($i+$mb.Length,$j-($i+$mb.Length)); $b64=[regex]::Replace($part,'[^A-Za-z0-9+/=]',''); if(($b64.Length -band 3) -ne 0){Write-Error 'Base64 uzunlugu gecersiz'; exit 1}; [IO.File]::WriteAllBytes('%ZIP%',[Convert]::FromBase64String($b64)); Expand-Archive -LiteralPath '%ZIP%' -DestinationPath '%TARGET%' -Force"
if errorlevel 1 goto :TRYPY
goto :EXTRACTED

:TRYPY
echo       PowerShell cikaramadi, Python deneniyor...
where python >nul 2>nul
if errorlevel 1 goto :TRYTAR
python -c "import base64,re,zipfile;d=open(r'%~f0','rb').read().decode('ascii');b='NOVA'+'_PAYLOAD_BEGIN';e='NOVA'+'_PAYLOAD_END';i=d.index(b);j=d.index(e,i);s=re.sub(r'[^A-Za-z0-9+/=]','',d[i+len(b):j]);open(r'%ZIP%','wb').write(base64.b64decode(s));zipfile.ZipFile(r'%ZIP%').extractall(r'%TARGET%')"
if errorlevel 1 goto :TRYTAR
goto :EXTRACTED

:TRYTAR
echo       tar deneniyor...
tar -xf "%ZIP%" -C "%TARGET%"
if errorlevel 1 goto :FAIL

:EXTRACTED
del /q "%ZIP%" >nul 2>nul
echo [2/3] Cikarildi.
echo.
dir /b "%TARGET%"
echo.
echo [3/3] Python ortami (istege bagli)
set "SETUP="
set /p SETUP="      venv olusturulup bagimliliklar kurulsun mu? [e/H]: "
if /i "%SETUP%"=="e" goto :VENV
goto :DONE

:VENV
pushd "%TARGET%"
where python >nul 2>nul
if errorlevel 1 goto :NOPY
python -m venv .venv
if errorlevel 1 goto :NOPY
call ".venv\Scripts\activate.bat"
python -m pip install --upgrade pip
python -m pip install -r requirements.txt
if errorlevel 1 echo       [UYARI] Bagimliliklar tam kurulamadi (internet gerekli).
echo.
echo       Ortam hazir:
echo         cd /d "%TARGET%"
echo         .venv\Scripts\python -m uvicorn server:app --host 127.0.0.1 --port 5000
popd
goto :DONE

:NOPY
echo       [UYARI] Python 3.11+ bulunamadi: https://www.python.org/downloads/
popd
goto :DONE

:DONE
echo.
echo ============================================================
echo  Kurulum tamamlandi.
echo.
echo  Calistirma:
echo    cd /d "%TARGET%"
echo    python -m uvicorn server:app --host 127.0.0.1 --port 5000
echo.
echo  Tarayici: http://localhost:5000
echo.
echo  Gercek model icin (opsiyonel):
echo    set ANTHROPIC_API_KEY=sk-ant-...
echo  Anahtar yoksa Nova demo modunda calisir (araclar yine calisir).
echo.
echo  Testler:  python -m pytest
echo ============================================================
echo.
pause
exit /b 0

:NOPS
echo [HATA] PowerShell bulunamadi. Windows 10/11 gerekli.
pause
exit /b 1

:FAIL
echo [HATA] Cikarma basarisiz. Gecici zip: %ZIP%
pause
exit /b 1

