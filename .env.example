# ============================================================
# Nova v2 — örnek ortam değişkenleri
# Kopyalayıp .env olarak kaydet, sonra: set -a; source .env; set +a
# ============================================================

# --- Model sağlayıcı ---
# anthropic | openai | offline  (boşsa anahtara göre otomatik seçilir)
NOVA_PROVIDER=anthropic
# Claude API anahtarı (anthropic sağlayıcısı için)
ANTHROPIC_API_KEY=
# OpenAI uyumlu uç nokta kullanacaksan (vLLM, Ollama, OpenRouter, LM Studio...)
#OPENAI_API_KEY=
#NOVA_PROVIDER=openai
#NOVA_BASE_URL=http://localhost:11434/v1

# --- Model davranışı ---
# anthropic: claude-sonnet-5-5 | claude-haiku-5-5 | claude-opus-5-5
# openai   : gpt-4o-mini vb.
NOVA_MODEL=claude-sonnet-5-5
NOVA_MAX_TOKENS=800
NOVA_MAX_TOOL_ROUNDS=4
NOVA_HISTORY_LIMIT=10
# Anthropic çaba seviyesi: low | medium | high | xhigh | max
NOVA_EFFORT=medium
# Yalnızca OpenAI uyumlu sağlayıcılar için
NOVA_TEMPERATURE=0.4

# --- Hafıza ---
NOVA_MEMORY_DB=./nova.db

# --- Güvenlik / ağ ---
NOVA_RATE_LIMIT=90
NOVA_REQUEST_TIMEOUT=20
NOVA_ALLOW_PRIVATE_HOSTS=false
# Kurumsal proxy arkasında TLS hatası alırsan CA dosyanı göster:
#NOVA_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Virgülle ayrılmış izinli origin listesi (boşsa *)
#NOVA_CORS_ORIGINS=https://ornek.com,https://app.ornek.com
NOVA_LOG_LEVEL=INFO
